{
  "version": 2,
  "builds": [
    {
      "src": "ecs-backend/server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["ecs-backend/**"]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "ecs-teal.vercel.app" }],
      "headers": { "Location": "https://exceloncybersolutions.co.in/$1" },
      "status": 308
    },
    {
      "src": "/(.*)",
      "dest": "/ecs-backend/server.js"
    }
  ]
}
